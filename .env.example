# Copy to .env.local and fill in. This file is safe to commit (no real values).
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_TARGET=us
# Optional: voice used to narrate the demo video
ELEVENLABS_NARRATOR_VOICE_ID=
ELEVENLABS_CALLER_VOICE_ID=   # demo caller (default: premade "Chris")
NORA_VOICE_ID=                # Nora's voice (default: "Lauren B")

# Optional login gate: APP_PASS_HASH = scrypt hash from server/auth.ts hashPassword()
APP_USER=
APP_PASS_HASH=
